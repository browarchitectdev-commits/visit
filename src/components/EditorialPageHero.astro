---
interface StatItem {
  value: string;
  label: string;
}

interface Props {
  kicker: string;
  title: string;
  description: string;
  badge?: string;
  align?: 'left' | 'center';
  stats?: StatItem[];
}

const {
  kicker,
  title,
  description,
  badge,
  align = 'center',
  stats = [],
} = Astro.props;

const centered = align === 'center';
---

<section class="page-shell pb-6 sm:pb-8">
  <div class={`section-shell hero-frame rounded-[2rem] px-6 py-16 sm:px-10 lg:px-14 lg:py-20 ${centered ? 'text-center' : ''}`}>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_28%),radial-gradient(circle_at_bottom_right,rgba(143,92,86,0.18),transparent_26%)]" aria-hidden="true"></div>
    <div class={`relative z-10 mx-auto ${centered ? 'max-w-3xl' : 'max-w-4xl'}`}>
      {badge && (
        <div class={`mb-5 ${centered ? 'flex justify-center' : ''}`}>
          <span class="eyebrow-pill border-white/15 bg-white/10 text-white/76">{badge}</span>
        </div>
      )}
      <span class={`editorial-kicker ${centered ? 'justify-center text-white/70 before:bg-white/35' : 'text-white/70 before:bg-white/35'}`}>
        {kicker}
      </span>
      <h1 class="mt-6 font-serif text-5xl font-bold leading-[0.98] tracking-tight text-white sm:text-6xl lg:text-7xl">
        {title}
      </h1>
      <p class={`mt-6 text-base leading-relaxed text-white/74 sm:text-lg ${centered ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}>
        {description}
      </p>

      {stats.length > 0 && (
        <div class={`mt-10 grid gap-3 ${centered ? 'sm:grid-cols-3' : 'sm:grid-cols-3 max-w-3xl'}`}>
          {stats.map((item) => (
            <div class="rounded-[1.5rem] border border-white/12 bg-white/8 px-5 py-4 backdrop-blur-sm">
              <div class="font-serif text-3xl font-bold text-white sm:text-4xl">{item.value}</div>
              <div class="mt-1 text-[11px] uppercase tracking-[0.18em] text-white/56">{item.label}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
