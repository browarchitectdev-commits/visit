---
import type { CollectionEntry } from 'astro:content';

interface Props {
  master: CollectionEntry<'masters'>;
}

const { master } = Astro.props;
const { name, position, experience, bio, photo, instagram, telegram } = master.data;
const webpPhoto = typeof photo === 'string' ? photo.replace(/\.(jpe?g|png)$/i, '.webp') : photo;
---

<article class="editorial-panel group overflow-hidden rounded-[1.8rem]" role="article" aria-label={`Specialista: ${name}`}>
  <div class="relative aspect-[3/4] overflow-hidden bg-muted">
    <picture>
      <source srcset={webpPhoto} type="image/webp" />
      <img src={photo} alt={`Ritratto di ${name}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
    </picture>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent,rgba(20,13,10,0.62))]"></div>
    <div class="absolute right-4 top-4 rounded-full border border-white/20 bg-white/85 px-3 py-1.5 text-xs font-semibold text-card-foreground backdrop-blur-sm">
      {experience}+ anni
    </div>
  </div>

  <div class="p-5">
    <h3 class="font-serif text-3xl font-semibold text-card-foreground">{name}</h3>
    <p class="mt-1 text-sm font-semibold text-primary">{position}</p>
    <p class="mt-4 text-sm leading-relaxed text-muted-foreground line-clamp-5">{bio}</p>
    {(instagram || telegram) && (
      <div class="mt-5 flex gap-2">
        {instagram && <a href={instagram} target="_blank" rel="noopener noreferrer" class="rounded-full bg-foreground px-4 py-2 text-xs font-semibold text-background">Instagram</a>}
        {telegram && <a href={telegram} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#229ED9] px-4 py-2 text-xs font-semibold text-white">Telegram</a>}
      </div>
    )}
  </div>
</article>
