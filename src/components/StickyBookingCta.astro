---
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();
const telegramUrl = contactLinks.telegramUrl;
const primaryUrl = telegramUrl || '/contacts';
---

<aside class="fixed inset-x-3 bottom-3 z-40 sm:inset-x-auto sm:bottom-6 sm:right-6" aria-label="Prenotazione rapida">
  <div class="mx-auto flex max-w-md items-center gap-2 rounded-full border border-white/45 bg-[#fffaf6]/88 p-2 shadow-[0_22px_60px_-34px_rgba(33,24,19,0.68)] backdrop-blur-xl sm:max-w-none">
    <a
      href={primaryUrl}
      target={primaryUrl.startsWith('http') || primaryUrl.startsWith('tg:') ? '_blank' : undefined}
      rel={primaryUrl.startsWith('http') || primaryUrl.startsWith('tg:') ? 'noopener noreferrer' : undefined}
      class="btn-shimmer inline-flex flex-1 items-center justify-center rounded-full bg-foreground px-4 py-3 text-sm font-semibold text-background transition-transform hover:scale-[1.01] sm:flex-none sm:px-5"
    >
      Prenota ora
    </a>
  </div>
</aside>
