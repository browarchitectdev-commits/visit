---
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
  index?: number;
}

const { service, index = 0 } = Astro.props;
const { name, price, duration, description, image } = service.data;
const animationDelay = index * 0.1;
const formattedPrice = price.toLocaleString('it-IT');

const formatDuration = (minutes: number): string => {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;

  if (hours === 0) return `${mins} min`;
  if (mins === 0) return `${hours} h`;
  return `${hours} h ${mins} min`;
};

const webpImage = typeof image === 'string' ? image.replace(/\.(jpe?g|png)$/i, '.webp') : image;
---

<article
  class="scroll-card group flex flex-col overflow-hidden rounded-[1.7rem] border border-border/70 bg-white/80 shadow-[0_18px_45px_-34px_rgba(33,24,19,0.45)]"
  data-scroll-card
  data-reveal-delay={String(animationDelay)}
  role="article"
  aria-label={`Servizio: ${name}`}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-muted">
    <picture>
      <source srcset={webpImage} type="image/webp" />
      <img
        src={image}
        alt={`Immagine del servizio: ${name}`}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent,rgba(25,16,12,0.38))]"></div>
    <div class="absolute right-4 top-4 rounded-full border border-white/20 bg-white/85 px-3 py-1.5 text-xs font-semibold text-card-foreground backdrop-blur-sm">
      {formatDuration(duration)}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-serif text-2xl font-semibold leading-tight text-card-foreground">
      {name}
    </h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground line-clamp-4">
      {description}
    </p>
    <div class="mt-5 flex items-center justify-between gap-4 border-t border-border/70 pt-4">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Da</span>
        <span class="mt-1 block font-serif text-2xl font-semibold text-primary">EUR {formattedPrice}</span>
      </div>
      <a
        href="/contacts"
        class="rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-transform hover:-translate-y-0.5"
        aria-label={`Prenota il servizio ${name}`}
      >
        Prenota
      </a>
    </div>
  </div>
</article>

<style>
  .scroll-card {
    opacity: 0;
    transform: translateY(28px) scale(0.97);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
  }
  .scroll-card.is-visible,
  .scroll-card:hover {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>
