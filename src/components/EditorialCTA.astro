---
interface Props {
  kicker?: string;
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  kicker = 'Следующий шаг',
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="page-shell pt-4">
  <div class="section-shell cta-band rounded-[2rem] px-6 py-10 sm:px-10 sm:py-12">
    <div class="pointer-events-none absolute -right-20 top-0 h-56 w-56 rounded-full bg-primary/10 blur-[70px]" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <span class="editorial-kicker justify-center">{kicker}</span>
      <h2 class="mt-5 font-serif text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        {title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        {description}
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={primaryHref}
          class="btn-shimmer inline-flex items-center justify-center rounded-full bg-foreground px-7 py-3.5 text-sm font-semibold text-background transition-all duration-300 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {primaryLabel}
        </a>
        {secondaryHref && secondaryLabel && (
          <a
            href={secondaryHref}
            class="inline-flex items-center justify-center rounded-full border border-border/80 bg-white/55 px-7 py-3.5 text-sm font-semibold text-foreground transition-all duration-300 hover:bg-white/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
