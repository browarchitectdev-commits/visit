---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'gallery'>;
}

const { item } = Astro.props;
const { title, category, description, imageBefore, imageAfter } = item.data;

const categoryNames: Record<string, string> = {
  brouws: 'Sopracciglia',
  brows: 'Sopracciglia',
  lips: 'Labbra',
  eyeliner: 'Eyeliner',
  nails: 'Unghie',
  face: 'Viso',
  other: 'Altro',
};

const getWebpSource = (image: string) =>
  /\.(?:jpg|png)$/i.test(image) ? image.replace(/\.(?:jpg|png)$/i, '.webp') : null;

const beforeWebp = typeof imageBefore === 'string' ? getWebpSource(imageBefore) : null;
const afterWebp = typeof imageAfter === 'string' ? getWebpSource(imageAfter) : null;
---

<article class="editorial-panel group overflow-hidden rounded-[1.8rem]" role="article" aria-label={`Lavoro: ${title}`}>
  <div class="relative aspect-square overflow-hidden bg-muted">
    <picture>
      {afterWebp && <source srcset={afterWebp} type="image/webp" />}
      <img src={imageAfter} alt={`${title} - dopo`} class="h-full w-full object-cover" loading="lazy" decoding="async" />
    </picture>
    <div class="gallery-before-layer absolute inset-0">
      <picture>
        {beforeWebp && <source srcset={beforeWebp} type="image/webp" />}
        <img src={imageBefore} alt={`${title} - prima`} class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="gallery-divider absolute inset-y-0 left-1/2 w-0.5 bg-white shadow-lg"></div>
    <span class="absolute left-4 top-4 rounded-full bg-black/70 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm">Prima</span>
    <span class="absolute right-4 top-4 rounded-full bg-black/70 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm">Dopo</span>
  </div>

  <div class="p-5">
    <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">{categoryNames[category] ?? 'Portfolio'}</span>
    <h3 class="mt-4 font-serif text-2xl font-semibold text-card-foreground">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-3">{description}</p>
  </div>
</article>

<style>
  .gallery-before-layer {
    clip-path: inset(0 50% 0 0);
    transition: clip-path 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  article:hover .gallery-before-layer {
    clip-path: inset(0 70% 0 0);
  }
  .gallery-divider {
    transition: left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  article:hover .gallery-divider {
    left: 30%;
  }
</style>
