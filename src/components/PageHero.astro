---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  tone?: 'plain' | 'warm';
}

const { eyebrow, title, description, tone = 'warm' } = Astro.props;
const isWarm = tone === 'warm';
---

<section class={`section-shell relative overflow-hidden px-4 pb-12 pt-28 sm:px-6 sm:pb-14 lg:px-8 ${isWarm ? 'page-hero-soft' : ''}`}>
  <div class="kinetic-lines opacity-30" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 top-20 mx-auto h-52 max-w-3xl rounded-full bg-[radial-gradient(circle,rgba(224,188,145,0.22),transparent_66%)] blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-5xl text-center" data-reveal>
    <span class="section-label">{eyebrow}</span>
    <h1 class="mx-auto mt-5 max-w-4xl font-serif text-5xl font-semibold tracking-tight text-foreground sm:text-6xl lg:text-7xl">
      {title}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
      {description}
    </p>

    <div class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-3" aria-label="Punti di forza">
      <div class="editorial-panel rounded-2xl px-4 py-3 text-sm font-semibold text-card-foreground">Consulenza su misura</div>
      <div class="editorial-panel rounded-2xl px-4 py-3 text-sm font-semibold text-card-foreground">Tecniche delicate</div>
      <div class="editorial-panel rounded-2xl px-4 py-3 text-sm font-semibold text-card-foreground">Solo su appuntamento</div>
    </div>
  </div>
</section>
