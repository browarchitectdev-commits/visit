---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import BeforeAfterCard from '@/components/BeforeAfterCard.astro';
import PageHero from '@/components/PageHero.astro';
import EditorialCta from '@/components/EditorialCta.astro';
import { getCollection } from 'astro:content';
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();
const items = (await getCollection('gallery'))
  .filter((item: any) => item.data.isActive)
  .sort((a: any, b: any) => (a.data.order ?? 999) - (b.data.order ?? 999));

const pageTitle = 'Portfolio trucco permanente';
const pageDescription = 'Guarda il portfolio Brow & Lip Studio: lavori reali di sopracciglia, labbra ed eyeliner con risultati delicati e naturali.';
---

<Layout title={pageTitle} description={pageDescription} lang="it">
  <SiteHeader client:load telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <PageHero
    eyebrow="Portfolio"
    title="Risultati reali, dettagli delicati."
    description="Una selezione di lavori per osservare forma, colore e delicatezza del risultato finale."
  />

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      {items.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item: any) => <BeforeAfterCard item={item} />)}
        </div>
      ) : (
        <div class="editorial-panel rounded-[2rem] p-8 text-center text-muted-foreground">
          Il portfolio è momentaneamente vuoto.
        </div>
      )}
    </div>
  </section>

  <EditorialCta
    title="Vuoi capire quale risultato è adatto al tuo viso?"
    description="Scrivici in Telegram: guardiamo insieme forma, colore e tempistiche prima di fissare l'appuntamento."
    primaryHref={contactLinks.telegramUrl || '/contacts'}
    primaryText="Scrivici su Telegram"
    secondaryHref="/services"
    secondaryText="Vedi i servizi"
  />

  <SiteFooter telegramUrl={contactLinks.telegramUrl} homeNavigation />
</Layout>
