---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();
const pageTitle = 'Privacy Policy';
const pageDescription = 'Informativa sul trattamento dei dati personali di Brow & Lip Studio ai sensi del Regolamento UE 2016/679.';
const lastUpdated = '12 maggio 2026';

const sections = [
  {
    title: '1. Titolare del trattamento',
    body: [
      'Il titolare del trattamento è Brow & Lip Studio. I dati di contatto indicati sul sito possono essere utilizzati per richieste relative alla privacy.',
      'Dati del titolare da completare prima della pubblicazione: denominazione legale, indirizzo della sede, partita IVA/codice fiscale, email dedicata privacy se disponibile.',
    ],
  },
  {
    title: '2. Dati trattati',
    body: [
      'Possiamo trattare dati identificativi e di contatto, come nome, telefono, email e contenuto dei messaggi inviati tramite modulo, Telegram o altri canali indicati.',
      'Il sito può trattare dati tecnici di navigazione, come indirizzo IP, log del server, browser, dispositivo e pagine visitate, nei limiti necessari al funzionamento e alla sicurezza.',
    ],
  },
  {
    title: '3. Finalità e basi giuridiche',
    body: [
      'Rispondere alle richieste e gestire appuntamenti: esecuzione di misure precontrattuali o contrattuali richieste dall’interessato.',
      'Gestire sicurezza, prevenzione abusi e manutenzione tecnica: legittimo interesse del titolare.',
      'Adempiere obblighi di legge: obbligo legale. Eventuali comunicazioni promozionali vengono inviate solo con consenso, quando richiesto.',
    ],
  },
  {
    title: '4. Conservazione',
    body: [
      'I dati inviati tramite modulo o messaggio vengono conservati per il tempo necessario a gestire la richiesta e, se nasce un rapporto di servizio, per i tempi richiesti da obblighi fiscali, contabili o difensivi.',
      'I log tecnici vengono conservati per periodi limitati e proporzionati alle esigenze di sicurezza e funzionamento.',
    ],
  },
  {
    title: '5. Destinatari e fornitori',
    body: [
      'I dati possono essere trattati da fornitori tecnici, hosting provider, strumenti di comunicazione, sistemi di prenotazione e servizi necessari alla gestione del sito e degli appuntamenti.',
      'Quando necessario, tali soggetti agiscono come responsabili del trattamento o autonomi titolari secondo il ruolo effettivamente svolto.',
    ],
  },
  {
    title: '6. Cookie e contenuti di terze parti',
    body: [
      'Il sito può usare cookie tecnici necessari al funzionamento. Eventuali cookie analitici non tecnici, marketing o tracciamenti di terze parti richiedono una gestione conforme al consenso.',
      'Le pagine possono incorporare contenuti Instagram, TikTok, Facebook, strumenti di prenotazione o Telegram. Questi servizi possono trattare dati secondo le proprie informative.',
    ],
  },
  {
    title: '7. Diritti dell’interessato',
    body: [
      'L’interessato può chiedere accesso, rettifica, cancellazione, limitazione, opposizione, portabilità ove applicabile e revoca del consenso senza pregiudicare la liceità del trattamento precedente.',
      'È possibile proporre reclamo al Garante per la protezione dei dati personali.',
    ],
  },
  {
    title: '8. Aggiornamenti',
    body: [
      'Questa informativa può essere aggiornata per adeguamenti normativi, tecnici o organizzativi. La data di ultimo aggiornamento è indicata in alto.',
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} lang="it">
  <SiteHeader client:load bookingUrl={contactLinks.bookingUrl} telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <section class="section-shell relative overflow-hidden px-4 pb-12 pt-28 sm:px-6 lg:px-8">
    <div class="kinetic-lines opacity-30" aria-hidden="true"></div>
    <div class="mx-auto max-w-5xl text-center" data-reveal>
      <span class="section-label">Legal</span>
      <h1 class="mt-5 font-serif text-5xl font-semibold tracking-tight text-foreground sm:text-6xl">
        Privacy Policy
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Informativa sul trattamento dei dati personali ai sensi del Regolamento (UE) 2016/679. Ultimo aggiornamento: {lastUpdated}.
      </p>
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[18rem_1fr]">
      <aside class="editorial-panel h-fit rounded-[1.8rem] p-5 text-sm text-muted-foreground">
        <p class="font-semibold text-card-foreground">Nota operativa</p>
        <p class="mt-2 leading-relaxed">
          Prima della pubblicazione finale inserire i dati legali completi del titolare. Questa pagina è una base informativa e non sostituisce una consulenza legale.
        </p>
      </aside>

      <div class="space-y-5">
        {sections.map((section) => (
          <article class="editorial-panel rounded-[1.8rem] p-6">
            <h2 class="font-serif text-3xl font-semibold text-card-foreground">{section.title}</h2>
            <div class="mt-4 space-y-3 text-sm leading-relaxed text-muted-foreground">
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
        ))}

        <article class="editorial-panel chromatic-frame rounded-[1.8rem] p-6">
          <h2 class="font-serif text-3xl font-semibold text-card-foreground">Contatti privacy</h2>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            Per richieste privacy puoi scrivere a <a href="mailto:ciao@browlip.it" class="text-primary underline">ciao@browlip.it</a> o usare i contatti indicati nella pagina Contatti.
          </p>
        </article>
      </div>
    </div>
  </section>

  <SiteFooter telegramUrl={contactLinks.telegramUrl} bookingUrl={contactLinks.bookingUrl} homeNavigation />
</Layout>
