---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import MasterCard from '@/components/MasterCard.astro';
import PageHero from '@/components/PageHero.astro';
import EditorialCta from '@/components/EditorialCta.astro';
import { getCollection } from 'astro:content';
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();
const masters = (await getCollection('masters'))
  .filter((master: any) => master.data.isActive)
  .sort((a: any, b: any) => (a.data.order ?? 999) - (b.data.order ?? 999));

const pageTitle = 'Specialiste trucco permanente';
const pageDescription = 'Conosci il team di Brow & Lip Studio: specialiste in trucco permanente con esperienza, precisione e gusto estetico naturale.';
---

<Layout title={pageTitle} description={pageDescription} lang="it">
  <SiteHeader client:load bookingUrl={contactLinks.bookingUrl} telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <PageHero
    eyebrow="Team"
    title="Mani esperte, visione delicata."
    description="Ogni trattamento viene eseguito con ascolto, precisione e rispetto dell'armonia naturale del viso."
  />

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      {masters.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {masters.map((master: any) => <MasterCard master={master} />)}
        </div>
      ) : (
        <div class="editorial-panel rounded-[2rem] p-8 text-center text-muted-foreground">
          Le informazioni sul team non sono momentaneamente disponibili.
        </div>
      )}
    </div>
  </section>

  <EditorialCta
    title="Prenota una consulenza con il team"
    description="Raccontaci che risultato desideri: ti aiutiamo a scegliere trattamento, intensita e tempi corretti."
    primaryHref={contactLinks.telegramUrl || '/contacts'}
    primaryText="Scrivici su Telegram"
    secondaryHref="/gallery"
    secondaryText="Guarda il portfolio"
  />

  <SiteFooter telegramUrl={contactLinks.telegramUrl} bookingUrl={contactLinks.bookingUrl} homeNavigation />
</Layout>
