---
/**
 * Страница "Услуги"
 * 
 * Демонстрирует правильное использование Content Collections:
 * 1. Получение данных через getCollection()
 * 2. Фильтрация и сортировка на этапе сборки
 * 3. Передача типизированных данных в компоненты
 */

import Layout from '@/layouts/Layout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { getCollection } from 'astro:content';
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();

// Получаем все услуги из Content Collection
// Это происходит на этапе сборки (Build Time), а не в рантайме
const allServices = await getCollection('services');

// Фильтруем только активные услуги и сортируем по порядку
const activeServices = allServices
  .filter((service: any) => service.data.isActive)
  .sort((a: any, b: any) => {
    // Сортировка по полю 'order' (если указано), затем по названию
    const orderA = a.data.order ?? 999;
    const orderB = b.data.order ?? 999;
    
    if (orderA !== orderB) {
      return orderA - orderB;
    }
    
    return a.data.name.localeCompare(b.data.name, 'ru');
  });

// SEO мета-данные
const pageTitle = 'Наши услуги';
const pageDescription = `Профессиональные услуги перманентного макияжа. ${activeServices.length} услуг от опытных мастеров.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <SiteHeader client:load bookingUrl={contactLinks.bookingUrl} telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <!-- Hero секция -->
  <section class="bg-gradient-to-br from-blue-50 to-indigo-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          Наши услуги
        </h1>
        <p class="mx-auto max-w-2xl text-lg text-gray-600">
          Мы предлагаем полный спектр услуг по перманентному макияжу и уходу за лицом.
          Используем только сертифицированные материалы европейского качества.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Список услуг -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {
        activeServices.length > 0 ? (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {activeServices.map((service: any, index: number) => (
              <ServiceCard service={service} index={index} />
            ))}
          </div>
        ) : (
          <div class="rounded-lg bg-yellow-50 p-8 text-center">
            <p class="text-lg text-yellow-800">
              Услуги временно недоступны. Пожалуйста, вернитесь позже.
            </p>
          </div>
        )
      }
    </div>
  </section>
  
  <!-- CTA секция -->
  <section class="bg-blue-600 py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-white">
        Не нашли нужную услугу?
      </h2>
      <p class="mb-8 text-lg text-blue-100">
        Свяжитесь с нами, и мы подберем индивидуальное решение для вас
      </p>
      <a
        href="/contacts"
        class="inline-block rounded-lg bg-white px-8 py-3 font-semibold text-blue-600 transition-transform hover:scale-105 focus:outline-none focus:ring-4 focus:ring-blue-300"
      >
        Связаться с нами
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  let servicesRevealObserver;

  const initServicesReveal = () => {
    const cards = document.querySelectorAll('[data-scroll-card]');
    if (!cards.length) return;

    if (servicesRevealObserver) {
      servicesRevealObserver.disconnect();
    }

    // Если пользователь предпочитает уменьшенное движение — показываем сразу
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cards.forEach((card) => card.classList.add('is-visible'));
      return;
    }

    servicesRevealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const target = entry.target;
          if (!(target instanceof HTMLElement)) return;

          if (entry.isIntersecting) {
            // Устанавливаем stagger-задержку и показываем через transition
            const delay = target.dataset.revealDelay ?? '0';
            target.style.transitionDelay = `${delay}s`;
            target.classList.add('is-visible');
          } else {
            // Убираем видимость без задержки — сердцевина повторяемости
            target.style.transitionDelay = '0s';
            target.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.12 }
    );

    cards.forEach((card) => servicesRevealObserver.observe(card));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServicesReveal, { once: true });
  } else {
    initServicesReveal();
  }

  document.addEventListener('astro:page-load', initServicesReveal);
</script>
