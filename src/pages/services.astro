---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import ServiceCard from '@/components/ServiceCard.astro';
import PageHero from '@/components/PageHero.astro';
import EditorialCta from '@/components/EditorialCta.astro';
import { getCollection } from 'astro:content';
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();
const services = (await getCollection('services'))
  .filter((service: any) => service.data.isActive)
  .sort((a: any, b: any) => (a.data.order ?? 999) - (b.data.order ?? 999));

const pageTitle = 'Servizi di trucco permanente';
const pageDescription = 'Trattamenti di trucco permanente per sopracciglia, labbra ed eyeliner: tecniche delicate, consulenza su misura e risultati naturali.';
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servizi di trucco permanente',
  itemListElement: services.map((service: any, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.data.name,
      description: service.data.description,
      provider: {
        '@type': 'BeautySalon',
        name: 'Brow & Lip Studio',
      },
      offers: {
        '@type': 'Offer',
        price: service.data.price,
        priceCurrency: 'EUR',
      },
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={serviceJsonLd} lang="it">
  <SiteHeader client:load telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <PageHero
    eyebrow="Servizi"
    title="Trattamenti calibrati sul tuo viso."
    description="Ogni servizio parte da proporzioni, colore naturale e stile personale, per un risultato elegante e leggibile nel tempo."
  />

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      {services.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service: any, index: number) => <ServiceCard service={service} index={index} />)}
        </div>
      ) : (
        <div class="editorial-panel rounded-[2rem] p-8 text-center text-muted-foreground">
          I servizi non sono momentaneamente disponibili.
        </div>
      )}
    </div>
  </section>

  <EditorialCta
    eyebrow="Consulenza"
    title="Non sai quale trattamento scegliere?"
    description="Scrivici: valutiamo insieme forma, intensità e tempistiche prima di fissare l'appuntamento."
    primaryHref={contactLinks.telegramUrl || '/contacts'}
    primaryText="Scrivici su Telegram"
    secondaryHref="/contacts"
    secondaryText="Contatti"
  />

  <SiteFooter telegramUrl={contactLinks.telegramUrl} homeNavigation />
</Layout>
