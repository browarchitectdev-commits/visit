---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import ServiceCard from '@/components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { getPublicContactLinks } from '@/lib/publicLinks';

const contactLinks = getPublicContactLinks();
const services = (await getCollection('services'))
  .filter((service: any) => service.data.isActive)
  .sort((a: any, b: any) => (a.data.order ?? 999) - (b.data.order ?? 999));

const pageTitle = 'Servizi di trucco permanente';
const pageDescription = 'Trattamenti di trucco permanente per sopracciglia, labbra ed eyeliner: tecniche delicate, consulenza su misura e risultati naturali.';
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servizi di trucco permanente',
  itemListElement: services.map((service: any, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.data.name,
      description: service.data.description,
      provider: {
        '@type': 'BeautySalon',
        name: 'Brow & Lip Studio',
      },
      offers: {
        '@type': 'Offer',
        price: service.data.price,
        priceCurrency: 'EUR',
      },
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={serviceJsonLd} lang="it">
  <SiteHeader client:load bookingUrl={contactLinks.bookingUrl} telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <section class="section-shell relative overflow-hidden px-4 pb-10 pt-28 sm:px-6 lg:px-8">
    <div class="kinetic-lines opacity-35" aria-hidden="true"></div>
    <div class="mx-auto max-w-5xl text-center" data-reveal>
      <span class="section-label">Servizi</span>
      <h1 class="mt-5 font-serif text-5xl font-semibold tracking-tight text-foreground sm:text-6xl">
        Trattamenti calibrati sul tuo viso.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        Ogni servizio parte da proporzioni, colore naturale e stile personale, per un risultato elegante e leggibile nel tempo.
      </p>
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      {services.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service: any, index: number) => <ServiceCard service={service} index={index} />)}
        </div>
      ) : (
        <div class="editorial-panel rounded-[2rem] p-8 text-center text-muted-foreground">
          I servizi non sono momentaneamente disponibili.
        </div>
      )}
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="editorial-panel chromatic-frame mx-auto max-w-5xl rounded-[2rem] p-8 text-center">
      <p class="text-sm uppercase tracking-[0.22em] text-muted-foreground">Consulenza</p>
      <h2 class="mt-3 font-serif text-4xl font-semibold text-foreground">Non sai quale trattamento scegliere?</h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Scrivici: valutiamo insieme forma, intensita e tempistiche prima di fissare l’appuntamento.
      </p>
      <a href="/contacts" class="btn-shimmer mt-6 inline-flex rounded-full bg-foreground px-7 py-3 text-sm font-semibold text-background">
        Contattaci
      </a>
    </div>
  </section>

  <SiteFooter telegramUrl={contactLinks.telegramUrl} homeNavigation />
</Layout>
