---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { getPublicContactLinks } from '@/lib/publicLinks';

const pageTitle = 'Contacte';
const pageDescription =
  'Ia legatura cu noi prin telefon, email sau retele sociale. Suntem disponibili pentru programari si consultatii personalizate.';
const contactStatus = Astro.url.searchParams.get('contact');
const contactLinks = getPublicContactLinks();

const contacts = {
  phone: '+39 000 000 0000',
  phoneLink: 'tel:+390000000000',
  email: 'ciao@browlip.it',
  address: 'Italia, acces doar cu programare',
  workingHours: {
    weekdays: 'Luni - Vineri: 10:00 - 21:00',
    weekends: 'Sambata - Duminica: 11:00 - 20:00',
  },
  socials: {
    instagram: 'https://instagram.com/browarchitect.studio',
    telegram: 'https://t.me/beauty_salon',
    whatsapp: 'https://wa.me/390000000000',
  },
};
---

<Layout title={pageTitle} description={pageDescription} lang="ro">
  <SiteHeader client:load bookingUrl={contactLinks.bookingUrl} telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <section class="bg-gradient-to-br from-[#f8efe8] via-[#f7ece5] to-[#efe2d8] py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="mb-4 font-serif text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          Contacteaza-ne
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-muted-foreground">
          Suntem aici pentru intrebari, recomandari si programari. Alege canalul care iti este cel mai comod.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1.05fr] lg:px-8">
      <div class="space-y-8">
        <div class="rounded-[2rem] border border-border/70 bg-card p-8 shadow-[0_24px_60px_-44px_rgba(33,24,19,0.35)]">
          <h2 class="font-serif text-3xl font-semibold text-card-foreground">Detalii de contact</h2>

          <div class="mt-6 space-y-5">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-muted-foreground">Telefon</p>
                <a href={contacts.phoneLink} class="mt-1 block text-lg font-semibold text-card-foreground transition-colors hover:text-primary">
                  {contacts.phone}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-muted-foreground">Email</p>
                <a href={`mailto:${contacts.email}`} class="mt-1 block text-lg font-semibold text-card-foreground transition-colors hover:text-primary">
                  {contacts.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-muted-foreground">Adresa</p>
                <p class="mt-1 text-lg font-semibold text-card-foreground">{contacts.address}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-border/70 bg-secondary/35 p-8">
          <h3 class="font-serif text-2xl font-semibold text-foreground">Program</h3>
          <div class="mt-5 space-y-3 text-sm text-muted-foreground">
            <div class="flex items-center justify-between gap-4 rounded-2xl bg-background/70 px-4 py-3">
              <span>Luni - Vineri</span>
              <span class="font-semibold text-foreground">10:00 - 21:00</span>
            </div>
            <div class="flex items-center justify-between gap-4 rounded-2xl bg-background/70 px-4 py-3">
              <span>Sambata - Duminica</span>
              <span class="font-semibold text-foreground">11:00 - 20:00</span>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-8">
        <div id="contact-form" class="rounded-[2rem] border border-border/70 bg-card p-8 shadow-[0_24px_60px_-44px_rgba(33,24,19,0.35)]">
          <h2 class="font-serif text-3xl font-semibold text-card-foreground">Scrie-ne direct</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Daca preferi, ne poti lasa un mesaj si revenim cat mai curand posibil.
          </p>

          {contactStatus === 'success' && (
            <div class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
              Mesajul a fost trimis cu succes. L-am salvat si l-am trimis administratorului pe Telegram.
            </div>
          )}

          {contactStatus === 'validation' && (
            <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
              Completeaza toate campurile obligatorii si confirma acordul pentru prelucrarea datelor.
            </div>
          )}

          {contactStatus === 'error' && (
            <div class="mt-5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
              Nu am reusit sa trimitem mesajul acum. Incearca din nou sau contacteaza-ne prin Telegram.
            </div>
          )}

          <form class="mt-6 space-y-5" method="POST" action="/api/contact">
            <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <div>
              <label for="name" class="mb-2 block text-sm font-medium text-card-foreground">Nume</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-border bg-background px-4 py-3 transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="Numele tau" />
            </div>

            <div>
              <label for="phone" class="mb-2 block text-sm font-medium text-card-foreground">Telefon</label>
              <input type="tel" id="phone" name="phone" required class="w-full rounded-xl border border-border bg-background px-4 py-3 transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="+39 000 000 0000" />
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-card-foreground">Email</label>
              <input type="email" id="email" name="email" class="w-full rounded-xl border border-border bg-background px-4 py-3 transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="email@exemplu.com" />
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-medium text-card-foreground">Mesaj</label>
              <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-border bg-background px-4 py-3 transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="Spune-ne cu ce te putem ajuta..."></textarea>
            </div>

            <label class="flex items-start gap-3 text-sm text-muted-foreground">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-primary/25" />
              <span>
                Sunt de acord cu prelucrarea datelor personale conform
                <a href="/privacy" class="ml-1 text-primary underline hover:text-primary/80">politicii de confidentialitate</a>.
              </span>
            </label>

            <button type="submit" class="w-full rounded-full bg-primary px-6 py-3 font-semibold text-primary-foreground transition-transform hover:scale-[1.01] focus:outline-none focus:ring-4 focus:ring-primary/25">
              Trimite mesajul
            </button>
          </form>
        </div>

        <div class="rounded-[2rem] border border-border/70 bg-card p-8">
          <h3 class="font-serif text-2xl font-semibold text-card-foreground">Gaseste-ne si online</h3>
          <div class="mt-5 flex gap-3">
            <a href={contacts.socials.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[#f09433] via-[#e6683c] to-[#bc1888] text-white transition-transform hover:scale-105" aria-label="Instagram">
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z" /></svg>
            </a>
            <a href={contacts.socials.telegram} target="_blank" rel="noopener noreferrer" class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#229ED9] text-white transition-transform hover:scale-105" aria-label="Telegram">
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.328-.373-.115l-6.869 4.332-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.54-.203 1.01.122.84 1.125z" /></svg>
            </a>
            <a href={contacts.socials.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#25D366] text-white transition-transform hover:scale-105" aria-label="WhatsApp">
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
