---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import PageHero from '@/components/PageHero.astro';
import { getPublicContactLinks } from '@/lib/publicLinks';

const pageTitle = 'Contatti e prenotazioni';
const pageDescription =
  'Contatta Brow & Lip Studio per consulenze, prenotazioni e informazioni sui trattamenti di trucco permanente per sopracciglia e labbra.';
const contactStatus = Astro.url.searchParams.get('contact');
const contactLinks = getPublicContactLinks();

const contacts = {
  phone: '+35 1314 9394',
  phoneLink: 'tel:+3513149394',
  email: 'browarchitect2025@gmail.com',
  address: 'Italia, solo su appuntamento',
  socials: {
    instagram: 'https://instagram.com/browarchitect.studio',
    telegram: contactLinks.telegramUrl,
    whatsapp: 'https://wa.me/390000000000',
  },
};
---

<Layout title={pageTitle} description={pageDescription} lang="it">
  <SiteHeader client:load telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <PageHero
    eyebrow="Contatti"
    title="Parliamo del risultato che desideri."
    description="Scrivici per una consulenza, una prenotazione o una domanda prima del trattamento. Ti rispondiamo con attenzione e chiarezza."
  />

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <aside class="space-y-5">
        <div class="editorial-panel chromatic-frame rounded-[2rem] p-6">
          <h2 class="font-serif text-3xl font-semibold text-card-foreground">Dettagli</h2>
          <div class="mt-6 space-y-5">
            <a href={contacts.phoneLink} class="block rounded-[1.4rem] border border-border/70 bg-white/45 p-4 transition-transform hover:-translate-y-0.5">
              <span class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Telefono</span>
              <strong class="mt-2 block text-lg text-card-foreground">{contacts.phone}</strong>
            </a>
            <a href={`mailto:${contacts.email}`} class="block rounded-[1.4rem] border border-border/70 bg-white/45 p-4 transition-transform hover:-translate-y-0.5">
              <span class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Email</span>
              <strong class="mt-2 block text-lg text-card-foreground">{contacts.email}</strong>
            </a>
            <div class="rounded-[1.4rem] border border-border/70 bg-white/45 p-4">
              <span class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Indirizzo</span>
              <strong class="mt-2 block text-lg text-card-foreground">{contacts.address}</strong>
            </div>
          </div>
        </div>

        <div class="editorial-panel rounded-[2rem] p-6">
          <h3 class="font-serif text-2xl font-semibold text-card-foreground">Orari</h3>
          <div class="mt-5 space-y-3 text-sm text-muted-foreground">
            <div class="flex items-center justify-between rounded-2xl bg-background/70 px-4 py-3">
              <span>Lunedi - Venerdi</span>
              <span class="font-semibold text-foreground">10:00 - 19:00</span>
            </div>
            <div class="flex items-center justify-between rounded-2xl bg-background/70 px-4 py-3">
              <span>Sabato</span>
              <span class="font-semibold text-foreground">10:00 - 18:00</span>
            </div>
          </div>
        </div>
      </aside>

      <div id="contact-form" class="editorial-panel chromatic-frame rounded-[2rem] p-6 sm:p-8">
        <h2 class="font-serif text-3xl font-semibold text-card-foreground">Scrivici direttamente</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Lascia un messaggio: ti ricontattiamo appena possibile per capire esigenza, tempi e trattamento più adatto.
        </p>

        {contactStatus === 'success' && (
          <div class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            Messaggio inviato correttamente. Ti risponderemo al più presto.
          </div>
        )}
        {contactStatus === 'validation' && (
          <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            Compila i campi obbligatori e conferma il consenso al trattamento dei dati.
          </div>
        )}
        {contactStatus === 'error' && (
          <div class="mt-5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
            Non siamo riusciti a inviare il messaggio. Riprova o contattaci su Telegram.
          </div>
        )}

        <form class="mt-6 space-y-5" method="POST" action="/api/contact">
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-card-foreground">Nome</label>
            <input id="name" name="name" required class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="Il tuo nome" />
          </div>
          <div>
            <label for="phone" class="mb-2 block text-sm font-medium text-card-foreground">Telefono</label>
            <input id="phone" name="phone" type="tel" required class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="+35 1314 9394" />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-card-foreground">Email</label>
            <input id="email" name="email" type="email" class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="nome@email.it" />
          </div>
          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-card-foreground">Messaggio</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" placeholder="Raccontaci come possiamo aiutarti..."></textarea>
          </div>
          <label class="flex items-start gap-3 text-sm text-muted-foreground">
            <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-primary/25" />
            <span>Acconsento al trattamento dei dati personali secondo la <a href="/privacy" class="text-primary underline">Privacy Policy</a>.</span>
          </label>
          <button type="submit" class="btn-shimmer w-full rounded-full bg-primary px-6 py-3 font-semibold text-primary-foreground transition-transform hover:scale-[1.01]">
            Invia messaggio
          </button>
        </form>
      </div>
    </div>
  </section>

  <SiteFooter telegramUrl={contactLinks.telegramUrl} homeNavigation />
</Layout>
