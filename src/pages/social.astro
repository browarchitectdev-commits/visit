      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 flex flex-col items-center gap-2 text-center">
          <div class="mb-2 inline-flex h-1.5 w-16 rounded-full bg-black" aria-hidden="true"></div>
          <h2 id="tiktok-section-heading" class="text-2xl font-bold text-foreground sm:text-3xl">
