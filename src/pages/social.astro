---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import PageHero from '@/components/PageHero.astro';
import EditorialCta from '@/components/EditorialCta.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getPublicContactLinks } from '@/lib/publicLinks';

type SocialEntry = CollectionEntry<'social'>;
type SettingsEntry = CollectionEntry<'settings'>;

function extractInstagramPostId(postUrl: string): string | null {
  const match = postUrl.match(/instagram\.com\/(?:p|reel|tv)\/([A-Za-z0-9_-]+)/i);
  return match?.[1] ?? null;
}

function extractTikTokVideoId(postUrl: string): string | null {
  const match = postUrl.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/i);
  return match?.[1] ?? null;
}

function normalizeFacebookPostUrl(postUrl: string): string | null {
  try {
    const url = new URL(postUrl);
    if (!/facebook\.com$/i.test(url.hostname) || /^\/share\//i.test(url.pathname)) return null;
    if (/\/permalink\.php$/i.test(url.pathname)) return `${url.origin}${url.pathname}${url.search}`;
    return `${url.origin}${url.pathname}`.replace(/\/$/, '');
  } catch {
    return null;
  }
}

const contactLinks = getPublicContactLinks();
const socialCollection: SocialEntry[] = await getCollection('social');
const settings = ((await getCollection('settings')) as SettingsEntry[])[0]?.data;

const profiles = [
  {
    label: 'Instagram',
    user: settings?.instagramUsername || 'browarchitect.studio',
    url: settings?.instagramProfileUrl || 'https://www.instagram.com/browarchitect.studio/',
    className: 'from-[#f09433] via-[#e6683c] to-[#bc1888]',
  },
  {
    label: 'TikTok',
    user: settings?.tiktokUsername || 'browarchitect.stu',
    url: settings?.tiktokProfileUrl || 'https://www.tiktok.com/@browarchitect.stu',
    className: 'from-black to-neutral-700',
  },
  {
    label: 'Facebook',
    user: settings?.facebookPageName || 'Brow & Lip Studio',
    url: settings?.facebookPageUrl || 'https://www.facebook.com/profile.php?id=61575579803996',
    className: 'from-[#1877f2] to-[#1254a8]',
  },
];

const posts = socialCollection
  .filter((entry) => entry.data.isActive)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry) => {
    const platform = entry.data.platform;
    const embedId =
      platform === 'instagram'
        ? extractInstagramPostId(entry.data.postUrl)
        : platform === 'tiktok'
          ? extractTikTokVideoId(entry.data.postUrl)
          : normalizeFacebookPostUrl(entry.data.postUrl);

    return {
      id: entry.id,
      platform,
      title: entry.data.title || 'Contenuto social',
      caption: entry.data.caption,
      postUrl: entry.data.postUrl,
      embedId,
    };
  })
  .filter((post) => !!post.embedId)
  .map((post) => ({ ...post, embedId: post.embedId as string }));

const pageTitle = 'Social e risultati';
const pageDescription = 'Segui Brow & Lip Studio su Instagram, TikTok e Facebook: video, lavori reali e risultati di trucco permanente.';
---

<Layout title={pageTitle} description={pageDescription} lang="it">
  <SiteHeader client:load bookingUrl={contactLinks.bookingUrl} telegramUrl={contactLinks.telegramUrl} homeNavigation />

  <PageHero
    eyebrow="Social"
    title="Lavori, video e dettagli dallo studio."
    description="Una raccolta aggiornata di contenuti social per vedere atmosfera, risultati e piccoli momenti reali."
  />

  <section class="px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-3">
      {profiles.map((profile) => (
        <a href={profile.url} target="_blank" rel="noopener noreferrer" class="editorial-panel group rounded-[1.6rem] p-5 transition-transform hover:-translate-y-1">
          <div class={`h-11 w-11 rounded-2xl bg-gradient-to-br ${profile.className}`}></div>
          <p class="mt-4 text-sm font-semibold text-card-foreground">{profile.label}</p>
          <p class="mt-1 truncate text-xs text-muted-foreground">{profile.user}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="editorial-panel overflow-hidden rounded-[1.7rem]">
          <div class="flex items-center justify-between border-b border-border/60 px-4 py-3">
            <p class="line-clamp-1 text-sm font-medium text-card-foreground">{post.title}</p>
            <span class="rounded-full bg-primary/10 px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-primary">{post.platform}</span>
          </div>

          {post.platform === 'instagram' && (
            <iframe src={`https://www.instagram.com/p/${post.embedId}/embed`} class="w-full" style="min-height: 410px; border: 0;" loading="lazy" title={post.title} referrerpolicy="no-referrer"></iframe>
          )}
          {post.platform === 'tiktok' && (
            <iframe src={`https://www.tiktok.com/embed/${post.embedId}`} class="w-full" style="min-height: 500px; border: 0;" loading="lazy" title={post.title} referrerpolicy="no-referrer" allowfullscreen></iframe>
          )}
          {post.platform === 'facebook' && (
            <iframe src={`https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(post.embedId)}&show_text=true&width=500`} class="w-full" style="min-height: 460px; border: 0;" loading="lazy" title={post.title} referrerpolicy="no-referrer" allowfullscreen></iframe>
          )}

          <div class="border-t border-border/60 px-4 py-3">
            <a href={post.postUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-primary">Apri il post</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <EditorialCta
    title="Hai visto un risultato che ti piace?"
    description="Mandaci il riferimento in Telegram: capiamo insieme se è adatto ai tuoi lineamenti e al tuo colore naturale."
    primaryHref={contactLinks.telegramUrl || '/contacts'}
    primaryText="Scrivici su Telegram"
    secondaryHref="/gallery"
    secondaryText="Portfolio"
  />

  <SiteFooter telegramUrl={contactLinks.telegramUrl} bookingUrl={contactLinks.bookingUrl} homeNavigation />
</Layout>
