---
/**
 * Страница "Социальные сети"
 *
 * Содержит:
 * - Instagram embed (iframe)
 * - TikTok embed (iframe)
 * - Facebook embed (iframe)
 */

import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { SiteFooter } from '@/react/SiteFooter';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const pageTitle = 'Мы в социальных сетях';
const pageDescription =
  'Следите за нашими работами и новостями в Instagram, TikTok и Facebook. Brow & Lip Studio — перманентный макияж.';

function extractInstagramPostId(postUrl: string): string | null {
  try {
    const url = new URL(postUrl);
    const parts = url.pathname.split('/').filter(Boolean);
    const markerIndex = parts.findIndex((part) =>
      ['p', 'reel', 'tv'].includes(part.toLowerCase()),
    );

    if (markerIndex !== -1 && parts[markerIndex + 1]) {
      return parts[markerIndex + 1];
    }
  } catch {
    // Игнорируем ошибку URL и пробуем regex fallback ниже.
  }

  const match = postUrl.match(/instagram\.com\/(?:p|reel|tv)\/([A-Za-z0-9_-]+)/i);
  return match?.[1] ?? null;
}

function extractTikTokVideoId(postUrl: string): string | null {
  try {
    const url = new URL(postUrl);
    const parts = url.pathname.split('/').filter(Boolean);
    const videoIndex = parts.findIndex((part) => part.toLowerCase() === 'video');

    if (videoIndex !== -1 && parts[videoIndex + 1]) {
      return parts[videoIndex + 1];
    }
  } catch {
    // Игнорируем ошибку URL и пробуем regex fallback ниже.
  }

  const match = postUrl.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/i);
  return match?.[1] ?? null;
}

function extractFacebookPostUrl(postUrl: string): string | null {
  try {
    const url = new URL(postUrl);

    if (!/facebook\.com$/i.test(url.hostname)) {
      return null;
    }

    // Share-ссылки Facebook обычно не подходят для plugins/post.php.
    if (/^\/share\//i.test(url.pathname)) {
      return null;
    }

    // Для permalink.php важны query-параметры story_fbid/id.
    if (/\/permalink\.php$/i.test(url.pathname)) {
      return `${url.origin}${url.pathname}${url.search}`;
    }

    // Для /posts/... и /reel/... убираем трекинговые query/hash.
    return `${url.origin}${url.pathname}`.replace(/\/$/, '');
  } catch {
    return null;
  }
}

type SocialEntry = CollectionEntry<'social'>;

interface SocialPost {
  id: string;
  embedId: string | null;
  postUrl: string;
  title: string;
  caption?: string;
}

type SettingsEntry = CollectionEntry<'settings'>;

const socialCollection: SocialEntry[] = await getCollection('social');
const settingsCollection: SettingsEntry[] = await getCollection('settings');

const settings = settingsCollection[0]?.data;

const instagram = {
  username: settings?.instagramUsername || 'browarchitect.studio',
  profileUrl: settings?.instagramProfileUrl || 'https://www.instagram.com/browarchitect.studio/',
};

const tiktok = {
  username: settings?.tiktokUsername || 'browarchitect.studio',
  profileUrl: settings?.tiktokProfileUrl || 'https://www.tiktok.com/@browarchitect.stu',
};

const facebook = {
  pageName: settings?.facebookPageName || 'Brow & Lip Studio',
  pageUrl: settings?.facebookPageUrl || 'https://www.facebook.com/browarchitect.studio',
  showPageEmbed: settings?.facebookShowPageEmbed ?? false,
};

const instagramPosts: SocialPost[] = socialCollection
  .filter((entry: SocialEntry) => entry.data.platform === 'instagram' && entry.data.isActive)
  .sort((a: SocialEntry, b: SocialEntry) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry: SocialEntry) => {
    const embedId = extractInstagramPostId(entry.data.postUrl);

    return {
      id: entry.id,
      embedId,
      postUrl: entry.data.postUrl,
      title: entry.data.title || 'Пост в Instagram',
      caption: entry.data.caption,
    };
  });

const validInstagramPosts = instagramPosts.filter((post: SocialPost) => !!post.embedId);
const invalidInstagramPostsCount = instagramPosts.length - validInstagramPosts.length;

const tiktokPosts: SocialPost[] = socialCollection
  .filter((entry: SocialEntry) => entry.data.platform === 'tiktok' && entry.data.isActive)
  .sort((a: SocialEntry, b: SocialEntry) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry: SocialEntry) => {
    const embedId = extractTikTokVideoId(entry.data.postUrl);

    return {
      id: entry.id,
      embedId,
      postUrl: entry.data.postUrl,
      title: entry.data.title || 'Видео в TikTok',
      caption: entry.data.caption,
    };
  });

const validTikTokPosts = tiktokPosts.filter((post: SocialPost) => !!post.embedId);
const invalidTikTokPostsCount = tiktokPosts.length - validTikTokPosts.length;

const facebookPosts: SocialPost[] = socialCollection
  .filter((entry: SocialEntry) => entry.data.platform === 'facebook' && entry.data.isActive)
  .sort((a: SocialEntry, b: SocialEntry) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry: SocialEntry) => ({
    id: entry.id,
    embedId: extractFacebookPostUrl(entry.data.postUrl),
    postUrl: entry.data.postUrl,
    title: entry.data.title || 'Пост в Facebook',
    caption: entry.data.caption,
  }));

const validFacebookPosts = facebookPosts.filter((post: SocialPost) => !!post.embedId);
const invalidFacebookPostsCount = facebookPosts.length - validFacebookPosts.length;
---

