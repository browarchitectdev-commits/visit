---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { HeroSection } from '@/react/HeroSection';
import { StatsSection } from '@/react/StatsSection';
import { AboutSection } from '@/react/AboutSection';
import { ServicesList } from '@/react/ServicesList';
import { GallerySection } from '@/react/GallerySection';
import { SiteFooter } from '@/react/SiteFooter';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Service } from '@/react/ServicesList';
import { getPublicContactLinks } from '@/lib/publicLinks';

const servicesCollection = await getCollection('services');
const galleryCollection = await getCollection('gallery');
const socialCollection = await getCollection('social');
const settingsCollection = await getCollection('settings');

const services: Service[] = servicesCollection.map((s: any) => ({
  id: s.id,
  data: {
    name: s.data.name,
    description: s.data.description,
    duration: s.data.duration,
    image: typeof s.data.image === 'string' ? s.data.image : s.data.image.src,
    order: s.data.order,
    isActive: s.data.isActive,
  },
}));

const sortedServices = services.sort((a: Service, b: Service) => (a.data.order || 0) - (b.data.order || 0));
const sortedGallery = galleryCollection.sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));

const galleryImages = sortedGallery.map((item: any) => ({
  src: typeof item.data.imageAfter === 'string' ? item.data.imageAfter : item.data.imageAfter.src,
  alt: item.data.title,
}));

const settings = settingsCollection[0]?.data;

function extractInstagramPostId(postUrl: string): string | null {
  const match = postUrl.match(/instagram\.com\/(?:p|reel|tv)\/([A-Za-z0-9_-]+)/i);
  return match?.[1] ?? null;
}

function extractTikTokVideoId(postUrl: string): string | null {
  const match = postUrl.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/i);
  return match?.[1] ?? null;
}

function normalizeFacebookPostUrl(postUrl: string): string | null {
  try {
    const url = new URL(postUrl);

    if (!/facebook\.com$/i.test(url.hostname)) {
      return null;
    }

    if (/^\/share\//i.test(url.pathname)) {
      return null;
    }

    if (/\/permalink\.php$/i.test(url.pathname)) {
      return `${url.origin}${url.pathname}${url.search}`;
    }

    return `${url.origin}${url.pathname}`.replace(/\/$/, '');
  } catch {
    return null;
  }
}

interface SocialFeedItem {
  id: string;
  platform: 'instagram' | 'tiktok' | 'facebook';
  title: string;
  caption?: string;
  postUrl: string;
  embedId: string;
}

const socialProfiles = {
  instagram: {
    username: settings?.instagramUsername || 'browarchitect.studio',
    profileUrl: settings?.instagramProfileUrl || 'https://www.instagram.com/browarchitect.studio/',
  },
  tiktok: {
    username: settings?.tiktokUsername || 'browarchitect.stu',
    profileUrl: settings?.tiktokProfileUrl || 'https://www.tiktok.com/@browarchitect.stu',
  },
  facebook: {
    pageName: settings?.facebookPageName || 'Brow & Lip Studio',
    pageUrl: settings?.facebookPageUrl || 'https://www.facebook.com/profile.php?id=61575579803996',
  },
};

const socialFeedRaw = socialCollection
  .filter((entry: CollectionEntry<'social'>) => entry.data.isActive)
  .sort((a: CollectionEntry<'social'>, b: CollectionEntry<'social'>) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry: CollectionEntry<'social'>) => {
    let embedId: string | null = null;

    if (entry.data.platform === 'instagram') {
      embedId = extractInstagramPostId(entry.data.postUrl);
    }

    if (entry.data.platform === 'tiktok') {
      embedId = extractTikTokVideoId(entry.data.postUrl);
    }

    if (entry.data.platform === 'facebook') {
      embedId = normalizeFacebookPostUrl(entry.data.postUrl);
    }

    return {
      id: entry.id,
      platform: entry.data.platform,
      title: entry.data.title || 'Post',
      caption: entry.data.caption,
      postUrl: entry.data.postUrl,
      embedId,
    };
  });

const socialFeed: SocialFeedItem[] = socialFeedRaw
  .filter((post: { embedId: string | null }) => !!post.embedId)
  .map((post: {
    id: string;
    platform: 'instagram' | 'tiktok' | 'facebook';
    title: string;
    caption?: string;
    postUrl: string;
    embedId: string | null;
  }) => ({
    id: post.id,
    platform: post.platform,
    title: post.title,
    caption: post.caption,
    postUrl: post.postUrl,
    embedId: post.embedId!,
  }));

const stats = [
  { value: '500+', label: 'Clienti soddisfatte' },
  { value: '8+', label: 'Anni di esperienza' },
  { value: '100%', label: 'Standard di igiene' },
  { value: '24/7', label: 'Presenza social' },
];

const pageTitle = 'Brow & Lip Studio';
const pageDescription = 'Trucco permanente per sopracciglia, labbra ed eyeliner: consulenza personalizzata, tecnica delicata e risultati naturali in Italia.';

const heroTitle = 'Bellezza permanente con eleganza naturale';
const heroDescription = 'Trucco permanente per sopracciglia e labbra pensato per valorizzare il viso con equilibrio, delicatezza e raffinatezza.';

const aboutTitle = 'Uno studio pensato per chi cerca precisione, gusto e discrezione';
const aboutDescription = [
  'Brow & Lip Studio è uno spazio dedicato al trucco permanente per sopracciglia e labbra, dove tecnica e sensibilità estetica lavorano insieme per risultati armoniosi.',
  'Ogni trattamento inizia con un confronto attento: analizziamo lineamenti, proporzioni e desideri della cliente per un look naturale e sofisticato nel tempo.',
];

const isDev = import.meta.env.DEV;
const contactLinks = getPublicContactLinks();
---

<Layout title={pageTitle} description={pageDescription} preloadImage="/images/hero.webp" lang="it">
  {isDev && (
    <div class="fixed bottom-4 right-4 z-50">
      <a
        href="/admin"
        class="flex items-center gap-2 rounded-full bg-black px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:scale-105 hover:bg-neutral-800"
        title="Apri il pannello admin TinaCMS"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
        </svg>
        <span>Admin</span>
      </a>
    </div>
  )}

  <SiteHeader client:load telegramUrl={contactLinks.telegramUrl} showBookingCta={false} />

  <HeroSection
    client:visible
    title={heroTitle}
    description={heroDescription}
    backgroundImage="/images/hero.jpg"
    ctaText="Prenota una consulenza"
    telegramUrl={contactLinks.telegramUrl}
    secondaryCTA={{
      text: 'Scopri i servizi',
      href: '#services',
    }}
  />

  <StatsSection client:visible stats={stats} />

  <div class="pointer-events-none relative mx-auto -mt-2 h-12 max-w-7xl px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <div class="h-px w-full bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
  </div>

  <AboutSection
    client:visible
    image="/images/about.jpg"
    title={aboutTitle}
    description={aboutDescription}
  />

  <ServicesList
    client:visible
    services={sortedServices}
  />

  <div class="pointer-events-none relative mx-auto h-12 max-w-7xl px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <div class="mx-auto h-full w-full bg-[radial-gradient(circle_at_center,rgba(224,188,145,0.16),transparent_60%)]"></div>
  </div>

  {galleryImages.length > 0 && <GallerySection client:visible images={galleryImages} />}

  <section id="social" data-section-cinema class="section-shell relative overflow-hidden scroll-mt-28 bg-secondary/30 py-8 sm:py-10 lg:py-12">
    <div class="pointer-events-none absolute -top-16 right-0 h-72 w-72 rounded-full bg-primary/10 blur-[80px] animate-float-slow" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-16 left-0 h-64 w-64 rounded-full bg-[#e0bc91]/12 blur-[80px] animate-float-medium" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-5xl gap-4 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end" data-reveal>
        <div>
          <span class="section-label">Presenza social</span>
          <h2 class="mt-5 font-serif text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
            Segui lo studio attraverso lavori, video e momenti reali.
          </h2>
        </div>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Una selezione di contenuti che racconta risultati, atmosfera e dettagli del nostro modo di lavorare.
        </p>
      </div>

      <div class="mx-auto mt-6 grid max-w-4xl gap-3 sm:grid-cols-3">
        <a href={socialProfiles.instagram.profileUrl} target="_blank" rel="noopener noreferrer" class="editorial-panel group flex items-center gap-3.5 rounded-[1.6rem] px-4 py-3.5 transition-all duration-300 hover:-translate-y-0.5" data-reveal data-delay="100">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#f09433] via-[#e6683c] to-[#bc1888] text-white shadow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">Instagram</p>
            <p class="truncate text-xs text-muted-foreground">@{socialProfiles.instagram.username}</p>
          </div>
        </a>

        <a href={socialProfiles.tiktok.profileUrl} target="_blank" rel="noopener noreferrer" class="editorial-panel group flex items-center gap-3.5 rounded-[1.6rem] px-4 py-3.5 transition-all duration-300 hover:-translate-y-0.5" data-reveal data-delay="200">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-black text-white shadow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.54V6.77a4.85 4.85 0 01-1.02-.08z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">TikTok</p>
            <p class="truncate text-xs text-muted-foreground">@{socialProfiles.tiktok.username}</p>
          </div>
        </a>

        <a href={socialProfiles.facebook.pageUrl} target="_blank" rel="noopener noreferrer" class="editorial-panel group flex items-center gap-3.5 rounded-[1.6rem] px-4 py-3.5 transition-all duration-300 hover:-translate-y-0.5" data-reveal data-delay="300">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#1877f2] text-white shadow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">Facebook</p>
            <p class="truncate text-xs text-muted-foreground">{socialProfiles.facebook.pageName}</p>
          </div>
        </a>
      </div>

      {socialFeed.length > 0 && (
        <div class="mx-auto mt-6 grid max-w-6xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {socialFeed.map((post, pi) => (
            <article class="editorial-panel overflow-hidden rounded-[1.7rem] transition-all duration-500 hover:-translate-y-0.5" data-reveal data-delay={String(pi * 100 + 100)}>
              <div class="flex items-center justify-between border-b border-border/60 px-4 py-2.5">
                <p class="line-clamp-1 text-[13px] font-medium text-foreground">{post.title}</p>
                <span class={`ml-2 shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${post.platform === 'instagram' ? 'bg-pink-50 text-pink-600 border border-pink-100' : post.platform === 'tiktok' ? 'bg-neutral-100 text-neutral-600 border border-neutral-200' : 'bg-blue-50 text-blue-600 border border-blue-100'}`}>
                  {post.platform}
                </span>
              </div>

              {post.platform === 'instagram' && (
                <div class="embed-shell" style="min-height: 390px;">
                  <div class="embed-skeleton"></div>
                  <iframe src={`https://www.instagram.com/p/${post.embedId}/embed`} class="w-full" style="min-height: 390px; border: 0;" loading="lazy" allowtransparency={true} title={post.title} referrerpolicy="no-referrer" />
                </div>
              )}

              {post.platform === 'tiktok' && (
                <div class="embed-shell" style="min-height: 470px;">
                  <div class="embed-skeleton"></div>
                  <iframe src={`https://www.tiktok.com/embed/${post.embedId}`} class="w-full" style="min-height: 470px; border: 0;" loading="lazy" title={post.title} referrerpolicy="no-referrer" allowfullscreen />
                </div>
              )}

              {post.platform === 'facebook' && (
                <div class="embed-shell" style="min-height: 450px;">
                  <div class="embed-skeleton"></div>
                  <iframe src={`https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(post.embedId)}&show_text=true&width=500`} class="w-full" style="min-height: 450px; border: 0;" loading="lazy" title={post.title} referrerpolicy="no-referrer" allowfullscreen />
                </div>
              )}

              {(post.caption || post.postUrl) && (
                <div class="flex items-center justify-between gap-2 border-t border-border/60 px-4 py-2.5">
                  <p class="line-clamp-1 text-xs text-muted-foreground">{post.caption || 'Contenuto dallo studio'}</p>
                  <a href={post.postUrl} target="_blank" rel="noopener noreferrer" class="shrink-0 text-xs font-semibold text-primary transition-colors hover:text-primary/70">
                    Apri
                  </a>
                </div>
              )}
            </article>
          ))}
        </div>
      )}

      <div class="mt-6 text-center" data-reveal data-delay="200">
        <a href="/social" class="btn-shimmer inline-flex items-center gap-2 rounded-full bg-foreground px-8 py-3.5 text-sm font-semibold text-background transition-all duration-300 hover:opacity-90">
          Tutti i contenuti
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section data-section-cinema class="section-shell relative px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-7xl">
      <div class="cinematic-card editorial-panel glass-sheen shine-border rounded-[2rem] p-6 text-center shadow-[0_24px_70px_-50px_rgba(73,45,28,0.4)] sm:p-8 lg:p-10">
        <p class="text-sm uppercase tracking-[0.22em] text-muted-foreground">Prenotazione</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Scegli come preferisci prenotare
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
          Scrivici su Telegram: scegliamo insieme servizio, tempi e soluzione più adatta prima della conferma.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          {contactLinks.telegramUrl && (
            <a
              href={contactLinks.telegramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-[#229ED9]/20 bg-[#229ED9] px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-[#1c8fc4]"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.328-.373-.115l-6.869 4.332-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.54-.203 1.01.122.84 1.125z" />
              </svg>
              Scrivici su Telegram
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <SiteFooter telegramUrl={contactLinks.telegramUrl} />

  <script>
    function initEmbedSkeletons() {
      document.querySelectorAll('.embed-shell iframe').forEach((iframe) => {
        const frame = iframe as HTMLIFrameElement;
        if (frame.dataset.skeletonBound === 'true') return;

        frame.dataset.skeletonBound = 'true';

        const shell = frame.closest('.embed-shell');
        if (!shell) return;

        const markLoaded = () => {
          shell.classList.add('is-loaded');
        };

        frame.addEventListener('load', markLoaded, { once: true });

        window.setTimeout(() => {
          shell.classList.add('is-loaded');
        }, 4500);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEmbedSkeletons);
    } else {
      initEmbedSkeletons();
    }

    document.addEventListener('astro:page-load', initEmbedSkeletons);
  </script>
</Layout>
