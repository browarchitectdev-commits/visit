---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader } from '@/react/SiteHeader';
import { HeroSection } from '@/react/HeroSection';
import { StatsSection } from '@/react/StatsSection';
import { AboutSection } from '@/react/AboutSection';
import { ServicesList } from '@/react/ServicesList';
import { MastersList } from '@/react/MastersList';
import { GallerySection } from '@/react/GallerySection';
import { SiteFooter } from '@/react/SiteFooter';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Service } from '@/react/ServicesList';
import type { Master } from '@/react/MastersList';

// Получаем данные из Content Collections
const servicesCollection = await getCollection('services');
const mastersCollection = await getCollection('masters');
const galleryCollection = await getCollection('gallery');
const socialCollection = await getCollection('social');
const settingsCollection = await getCollection('settings');

// Преобразуем в подходящие типы
const services: Service[] = servicesCollection.map((s: any) => ({
  id: s.id,
  data: {
    name: s.data.name,
    description: s.data.description,
    price: s.data.price,
    duration: s.data.duration,
    image: typeof s.data.image === 'string' ? s.data.image : s.data.image.src,
    order: s.data.order,
    isActive: s.data.isActive,
  },
}));

const masters: Master[] = mastersCollection.map((m: any) => ({
  id: m.id,
  data: {
    name: m.data.name,
    position: m.data.position,
    experience: m.data.experience,
    bio: m.data.bio,
    photo: typeof m.data.photo === 'string' ? m.data.photo : m.data.photo.src,
    instagram: m.data.instagram,
    telegram: m.data.telegram,
    order: m.data.order,
    isActive: m.data.isActive,
  },
}));

// Сортируем по порядку
const sortedServices = services.sort((a: Service, b: Service) => (a.data.order || 0) - (b.data.order || 0));
const sortedMasters = masters.sort((a: Master, b: Master) => (a.data.order || 0) - (b.data.order || 0));
const sortedGallery = galleryCollection.sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));

// Готовим данные галереи
const galleryImages = sortedGallery.map((item: any) => ({
  src: typeof item.data.imageAfter === 'string' ? item.data.imageAfter : item.data.imageAfter.src,
  alt: item.data.title,
}));

const settings = settingsCollection[0]?.data;

function extractInstagramPostId(postUrl: string): string | null {
  const match = postUrl.match(/instagram\.com\/(?:p|reel|tv)\/([A-Za-z0-9_-]+)/i);
  return match?.[1] ?? null;
}

function extractTikTokVideoId(postUrl: string): string | null {
  const match = postUrl.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/i);
  return match?.[1] ?? null;
}

function normalizeFacebookPostUrl(postUrl: string): string | null {
  try {
    const url = new URL(postUrl);

    if (!/facebook\.com$/i.test(url.hostname)) {
      return null;
    }

    if (/^\/share\//i.test(url.pathname)) {
      return null;
    }

    if (/\/permalink\.php$/i.test(url.pathname)) {
      return `${url.origin}${url.pathname}${url.search}`;
    }

    return `${url.origin}${url.pathname}`.replace(/\/$/, '');
  } catch {
    return null;
  }
}

interface SocialFeedItem {
  id: string;
  platform: 'instagram' | 'tiktok' | 'facebook';
  title: string;
  caption?: string;
  postUrl: string;
  embedId: string;
}

const socialProfiles = {
  instagram: {
    username: settings?.instagramUsername || 'browarchitect.studio',
    profileUrl: settings?.instagramProfileUrl || 'https://www.instagram.com/browarchitect.studio/',
  },
  tiktok: {
    username: settings?.tiktokUsername || 'browarchitect.stu',
    profileUrl: settings?.tiktokProfileUrl || 'https://www.tiktok.com/@browarchitect.stu',
  },
  facebook: {
    pageName: settings?.facebookPageName || 'Brow & Lip Studio',
    pageUrl: settings?.facebookPageUrl || 'https://www.facebook.com/profile.php?id=61575579803996',
  },
};

const socialFeedRaw = socialCollection
  .filter((entry: CollectionEntry<'social'>) => entry.data.isActive)
  .sort((a: CollectionEntry<'social'>, b: CollectionEntry<'social'>) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((entry: CollectionEntry<'social'>) => {
    let embedId: string | null = null;

    if (entry.data.platform === 'instagram') {
      embedId = extractInstagramPostId(entry.data.postUrl);
    }

    if (entry.data.platform === 'tiktok') {
      embedId = extractTikTokVideoId(entry.data.postUrl);
    }

    if (entry.data.platform === 'facebook') {
      embedId = normalizeFacebookPostUrl(entry.data.postUrl);
    }

    return {
      id: entry.id,
      platform: entry.data.platform,
      title: entry.data.title || 'Публикация',
      caption: entry.data.caption,
      postUrl: entry.data.postUrl,
      embedId,
    };
  });

const socialFeed: SocialFeedItem[] = socialFeedRaw
  .filter((post: { embedId: string | null }) => !!post.embedId)
  .map((post: {
    id: string;
    platform: 'instagram' | 'tiktok' | 'facebook';
    title: string;
    caption?: string;
    postUrl: string;
    embedId: string | null;
  }) => ({
    id: post.id,
    platform: post.platform,
    title: post.title,
    caption: post.caption,
    postUrl: post.postUrl,
    embedId: post.embedId!,
  }));

// Статистика
const stats = [
  { value: '500+', label: 'Довольных клиентов' },
  { value: '8+', label: 'Лет опыта' },
  { value: '100%', label: 'Стерильность' },
  { value: '24/7', label: 'В социальных сетях' },
];

const pageTitle = 'Brow & Lip Studio - Перманентный макияж';
const pageDescription = 'Профессиональные услуги перманентного макияжа бровей и губ от сертифицированных мастеров. Естественная красота надолго.';

const heroTitle = 'Естественная красота надолго';
const heroDescription = 'Перманентный макияж бровей и губ от сертифицированных мастеров. Подчёркиваем вашу природную красоту с помощью авторских техник и премиальных пигментов.';

const aboutTitle = 'Красота, которой вы доверяете';
const aboutDescription = [
  'Brow & Lip Studio — это пространство, созданное для тех, кто хочет подчеркнуть свою природную красоту. Мы специализируемся на перманентном макияже бровей и губ, используя современные техники, которые дарят максимально естественный результат.',
  'Каждая процедура начинается с детальной консультации и построения индивидуальной формы, чтобы результат идеально подходил именно вам.',
];

// Development mode indicator
const isDev = import.meta.env.DEV;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Development Admin Panel Link -->
  {isDev && (
    <div class="fixed bottom-4 right-4 z-50">
      <a
        href="/admin"
        class="flex items-center gap-2 rounded-full bg-purple-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:bg-purple-700 hover:scale-105"
        title="Открыть админ-панель TinaCMS"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
        </svg>
        <span>Админка</span>
      </a>
    </div>
  )}

  {/* Header */}
  <SiteHeader client:load />

  {/* Hero Section */}
  <HeroSection
    client:visible
    title={heroTitle}
    description={heroDescription}
    backgroundImage="/images/hero.jpg"
    ctaText="Записаться на консультацию"
    ctaHref="#booking"
    secondaryCTA={{
      text: 'Наши услуги',
      href: '#services',
    }}
  />

  {/* Stats Section */}
  <StatsSection client:visible stats={stats} />

  {/* About Section */}
  <AboutSection
    client:visible
    image="/images/about.jpg"
    title={aboutTitle}
    description={aboutDescription}
  />

  {/* Services Section */}
  <ServicesList client:visible services={sortedServices} />

  {/* Masters Section */}
  <MastersList client:visible masters={sortedMasters} />

  {/* Gallery Section */}
  {galleryImages.length > 0 && <GallerySection client:visible images={galleryImages} />}

  {/* Social Section */}
  <section class="relative overflow-hidden bg-secondary/20 py-10 sm:py-12">
    {/* Decorative background orbs */}
    <div class="pointer-events-none absolute -top-16 right-0 h-72 w-72 rounded-full bg-primary/8 blur-[80px] animate-float-slow" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-16 left-0 h-64 w-64 rounded-full bg-[#1877f2]/6 blur-[80px] animate-float-medium" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Section Header */}
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="section-label">Соцсети</span>
        <h2 class="mt-5 font-serif text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
          Мы в социальных сетях
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
          Следите за свежими работами, видео и новостями студии
        </p>
      </div>

      {/* Profile cards */}
      <div class="mx-auto mt-6 grid max-w-3xl gap-3 sm:grid-cols-3">
        <a
          href={socialProfiles.instagram.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3.5 rounded-2xl border border-border/70 bg-card/90 px-4 py-3.5 shadow-[0_1px_6px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:shadow-[0_8px_18px_-16px_rgba(0,0,0,0.12)] hover:border-primary/20"
          data-reveal data-delay="100"
        >
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#f09433] via-[#e6683c] to-[#bc1888] text-white shadow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">Instagram</p>
            <p class="truncate text-xs text-muted-foreground">@{socialProfiles.instagram.username}</p>
          </div>
          <svg class="ml-auto h-4 w-4 shrink-0 text-muted-foreground/50 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>

        <a
          href={socialProfiles.tiktok.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3.5 rounded-2xl border border-border/70 bg-card/90 px-4 py-3.5 shadow-[0_1px_6px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:shadow-[0_8px_18px_-16px_rgba(0,0,0,0.12)] hover:border-border"
          data-reveal data-delay="200"
        >
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-black text-white shadow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.54V6.77a4.85 4.85 0 01-1.02-.08z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">TikTok</p>
            <p class="truncate text-xs text-muted-foreground">@{socialProfiles.tiktok.username}</p>
          </div>
          <svg class="ml-auto h-4 w-4 shrink-0 text-muted-foreground/50 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>

        <a
          href={socialProfiles.facebook.pageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3.5 rounded-2xl border border-border/70 bg-card/90 px-4 py-3.5 shadow-[0_1px_6px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:shadow-[0_8px_18px_-16px_rgba(0,0,0,0.12)] hover:border-[#1877f2]/20"
          data-reveal data-delay="300"
        >
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#1877f2] text-white shadow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">Facebook</p>
            <p class="truncate text-xs text-muted-foreground">{socialProfiles.facebook.pageName}</p>
          </div>
          <svg class="ml-auto h-4 w-4 shrink-0 text-muted-foreground/50 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>

      {/* Post feed */}
      {socialFeed.length > 0 && (
        <div class="mx-auto mt-6 grid max-w-6xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {socialFeed.map((post, pi) => (
            <article
              class="overflow-hidden rounded-2xl border border-border/70 bg-card/90 shadow-[0_1px_6px_-3px_rgba(0,0,0,0.07)] transition-all duration-500 hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-16px_rgba(0,0,0,0.14)]"
              data-reveal
              data-delay={String(pi * 100 + 100)}
            >
              <div class="flex items-center justify-between border-b border-border/60 px-4 py-2.5">
                <p class="line-clamp-1 text-[13px] font-medium text-foreground">{post.title}</p>
                <span class={`ml-2 shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${post.platform === 'instagram' ? 'bg-pink-50 text-pink-600 border border-pink-100' : post.platform === 'tiktok' ? 'bg-neutral-100 text-neutral-600 border border-neutral-200' : 'bg-blue-50 text-blue-600 border border-blue-100'}`}>
                  {post.platform}
                </span>
              </div>

              {post.platform === 'instagram' && (
                <iframe
                  src={`https://www.instagram.com/p/${post.embedId}/embed`}
                  class="w-full"
                  style="min-height: 390px; border: 0;"
                  loading="lazy"
                  scrolling="no"
                  allowtransparency={true}
                  title={post.title}
                  referrerpolicy="no-referrer"
                />
              )}

              {post.platform === 'tiktok' && (
                <iframe
                  src={`https://www.tiktok.com/embed/${post.embedId}`}
                  class="w-full"
                  style="min-height: 470px; border: 0;"
                  loading="lazy"
                  title={post.title}
                  referrerpolicy="no-referrer"
                  allowfullscreen
                />
              )}

              {post.platform === 'facebook' && (
                <iframe
                  src={`https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(post.embedId)}&show_text=true&width=500`}
                  class="w-full"
                  style="min-height: 450px; border: 0;"
                  loading="lazy"
                  title={post.title}
                  referrerpolicy="no-referrer"
                  allowfullscreen
                />
              )}

              {(post.caption || post.postUrl) && (
                <div class="flex items-center justify-between gap-2 border-t border-border/60 px-4 py-2.5">
                  <p class="line-clamp-1 text-xs text-muted-foreground">{post.caption || 'Публикация студии'}</p>
                  <a
                    href={post.postUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 text-xs font-semibold text-primary transition-colors hover:text-primary/70"
                  >
                    Открыть ↗
                  </a>
                </div>
              )}
            </article>
          ))}
        </div>
      )}

      {/* CTA */}
      <div class="mt-6 text-center" data-reveal data-delay="200">
        <a
          href="/social"
          class="btn-shimmer inline-flex items-center gap-2 rounded-full bg-foreground px-8 py-3.5 text-sm font-semibold text-background shadow-sm transition-all duration-300 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Все публикации
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* Footer */}
  <SiteFooter client:load />
</Layout>
