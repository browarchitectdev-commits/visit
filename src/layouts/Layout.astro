---
/**
 * Base layout for the editorial landing page.
 */
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
  preloadImage?: string;
  canonicalURL?: string;
  keywords?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  lang?: string;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  preloadImage,
  canonicalURL,
  keywords = 'trucco permanente, permanent makeup, sopracciglia, labbra, brow studio, lip blush',
  jsonLd,
  noIndex = false,
  lang = 'it',
} = Astro.props;

const siteName = 'Brow & Lip Studio';
const fullTitle = title === siteName ? `${siteName} | Trucco permanente sopracciglia e labbra` : `${title} | ${siteName}`;
const siteURL = Astro.site ?? new URL('https://visit-weld.vercel.app');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalizedCanonicalURL = canonicalURL ?? new URL(currentPath, siteURL).href;
const ogImageURL = new URL(image, siteURL);
const breadcrumbName = currentPath === '/' ? 'Home' : title;
const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BeautySalon',
    '@id': new URL('/#studio', siteURL).href,
    name: siteName,
    url: new URL('/', siteURL).href,
    image: ogImageURL.href,
    description,
    priceRange: '$$',
    areaServed: 'Italy',
    sameAs: [
      'https://www.instagram.com/browarchitect.studio/',
      'https://www.tiktok.com/@browarchitect.stu',
      'https://t.me/pilotix_bot',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', siteURL).href,
      },
      ...(currentPath === '/'
        ? []
        : [
            {
              '@type': 'ListItem',
              position: 2,
              name: breadcrumbName,
              item: normalizedCanonicalURL,
            },
          ]),
    ],
  },
];
const structuredData = [...baseJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8efe7" />
    <link rel="canonical" href={normalizedCanonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={normalizedCanonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:alt" content={`${siteName} - ${title}`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="it_IT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={normalizedCanonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --background: #f8efe7;
        --foreground: #211813;
        --card: rgba(255, 251, 247, 0.9);
        --card-foreground: #241915;
        --popover: #fffaf6;
        --popover-foreground: #241915;
        --primary: #c15f64;
        --primary-foreground: #fff7f2;
        --secondary: #efe1d0;
        --secondary-foreground: #3a2d28;
        --muted: #eadbd2;
        --muted-foreground: #715d57;
        --accent: #e4b96e;
        --accent-foreground: #2b1d16;
        --border: rgba(88, 60, 45, 0.14);
        --input: rgba(88, 60, 45, 0.14);
        --ring: #c15f64;
        --rose: #f19aa3;
        --coral: #f47a5f;
        --champagne: #f3d08c;
        --sage: #93b69a;
        --berry: #8b3b61;
        --ink: #211813;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--background);
        overflow-x: clip;
      }

      body {
        min-height: 100vh;
        position: relative;
        color: var(--foreground);
        background:
          radial-gradient(circle at 12% 10%, rgba(241, 154, 163, 0.18), transparent 34%),
          radial-gradient(circle at 82% 14%, rgba(243, 208, 140, 0.24), transparent 30%),
          radial-gradient(circle at 22% 68%, rgba(147, 182, 154, 0.13), transparent 28%),
          radial-gradient(circle at 72% 78%, rgba(244, 122, 95, 0.12), transparent 30%),
          linear-gradient(180deg, #fff8f1 0%, #f8efe7 38%, #f3e7dc 68%, #efe2d8 100%);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        animation: pageEnter 0.45s cubic-bezier(0.16, 1, 0.3, 1) both, backgroundDrift 34s ease-in-out infinite;
      }

      body::before,
      body::after {
        content: '';
        position: fixed;
        inset: auto;
        z-index: -1;
        pointer-events: none;
        filter: blur(74px);
        opacity: 0.5;
      }

      body::before {
        left: -10rem;
        top: -8rem;
        width: 32rem;
        height: 32rem;
        background: radial-gradient(circle, rgba(205, 159, 136, 0.16), transparent 70%);
        animation: auraFloat 17s ease-in-out infinite, pulseGlow 12s ease-in-out infinite;
      }

      body::after {
        right: -8rem;
        bottom: -8rem;
        width: 30rem;
        height: 30rem;
        background: radial-gradient(circle, rgba(229, 208, 181, 0.18), transparent 70%);
        animation: auraFloat 21s ease-in-out infinite reverse, pulseGlow 15s ease-in-out infinite reverse;
      }

      body.modal-open {
        overflow: hidden;
      }

      #main-content {
        position: relative;
      }

      #main-content::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.14;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.4) 1px, transparent 1px);
        background-size: 52px 52px;
        mask-image: radial-gradient(circle at center, black 12%, transparent 74%);
        animation: gridDrift 32s linear infinite;
      }

      #main-content::after {
        content: '';
        position: fixed;
        inset: -18% auto auto 46%;
        z-index: -1;
        width: 44rem;
        height: 44rem;
        pointer-events: none;
        opacity: 0.16;
        border-radius: 999px;
        background:
          conic-gradient(
            from 180deg,
            rgba(182, 106, 89, 0) 0deg,
            rgba(182, 106, 89, 0.12) 70deg,
            rgba(224, 188, 145, 0.18) 150deg,
            rgba(255, 255, 255, 0) 240deg,
            rgba(182, 106, 89, 0) 360deg
          );
        filter: blur(58px);
        transform-origin: center;
        animation: haloRotate 28s linear infinite;
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
      }

      [data-reveal="left"] {
        transform: translateX(-28px);
      }

      [data-reveal="right"] {
        transform: translateX(28px);
      }

      [data-reveal="scale"] {
        transform: scale(0.94);
      }

      [data-reveal].is-visible {
        opacity: 1;
        transform: none;
      }

      [data-delay="100"] { transition-delay: 0.1s; }
      [data-delay="150"] { transition-delay: 0.15s; }
      [data-delay="200"] { transition-delay: 0.2s; }
      [data-delay="250"] { transition-delay: 0.25s; }
      [data-delay="300"] { transition-delay: 0.3s; }
      [data-delay="400"] { transition-delay: 0.4s; }
      [data-delay="500"] { transition-delay: 0.5s; }
      [data-delay="600"] { transition-delay: 0.6s; }

      .section-shell {
        position: relative;
      }

      .section-shell::before {
        content: '';
        position: absolute;
        inset: 0 auto auto 0;
        width: min(18rem, 42vw);
        height: 1px;
        background: linear-gradient(90deg, rgba(182, 106, 89, 0.4), transparent);
        opacity: 0.6;
      }

      .section-shell::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: -2.5rem;
        width: min(34rem, 72vw);
        height: 7rem;
        transform: translateX(-50%);
        border-radius: 999px;
        background: radial-gradient(circle, rgba(224, 188, 145, 0.18), rgba(224, 188, 145, 0.06) 38%, transparent 72%);
        filter: blur(32px);
        opacity: 0.5;
        pointer-events: none;
      }

      [data-section-cinema] {
        opacity: 0;
        transform: translateY(42px) scale(0.986);
        transition:
          opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
          transform 1s cubic-bezier(0.16, 1, 0.3, 1),
          filter 1s cubic-bezier(0.16, 1, 0.3, 1);
        filter: saturate(0.94);
      }

      [data-section-cinema].is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: saturate(1);
      }

      .cinematic-card {
        position: relative;
        isolation: isolate;
        transition:
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          box-shadow 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          border-color 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, box-shadow;
      }

      .cinematic-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), transparent 28%, transparent 72%, rgba(182, 106, 89, 0.08));
        opacity: 0;
        transition: opacity 0.5s ease;
        z-index: 1;
      }

      .cinematic-media {
        transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), filter 0.75s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, filter;
      }

      .cinematic-panel {
        transition:
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          background-color 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          border-color 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          box-shadow 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
      }

      .cinematic-copy {
        transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
      }

      @media (hover: hover) {
        .cinematic-card:hover {
          transform: translateY(-10px) scale(1.01);
          box-shadow: 0 34px 72px -34px rgba(44, 27, 18, 0.5);
        }

        .cinematic-card:hover::before {
          opacity: 1;
        }

        .cinematic-card:hover .cinematic-media {
          transform: scale(1.065);
          filter: saturate(1.02) contrast(1.03);
        }

        .cinematic-card:hover .cinematic-panel {
          transform: translateY(-4px);
          border-color: rgba(182, 106, 89, 0.24);
          box-shadow: 0 18px 40px -28px rgba(44, 27, 18, 0.3);
        }

        .cinematic-card:hover .cinematic-copy {
          transform: translateY(-2px);
        }
      }

      .section-label {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--primary);
      }

      .section-label::before,
      .section-label::after {
        content: '';
        display: block;
        width: 2.75rem;
        height: 1px;
        background: linear-gradient(90deg, rgba(182, 106, 89, 0.9), rgba(182, 106, 89, 0.15));
      }

      .editorial-panel {
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(255, 251, 247, 0.9), rgba(249, 241, 235, 0.75));
        box-shadow:
          0 18px 55px -34px rgba(44, 27, 18, 0.36),
          inset 0 1px 0 rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(12px);
      }

      .editorial-panel::before {
        content: '';
        position: absolute;
        inset: 1px 1px auto 1px;
        height: 1px;
        background: linear-gradient(90deg, rgba(255,255,255,0.55), transparent 72%);
        pointer-events: none;
      }

      .parallax-soft {
        animation: parallaxSoft 16s ease-in-out infinite;
      }

      .ambient-orb {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        filter: blur(18px);
        mix-blend-mode: screen;
        animation: orbDance 16s ease-in-out infinite;
      }

      .glass-sheen {
        position: relative;
        overflow: hidden;
      }

      .glass-sheen::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(120deg, transparent 18%, rgba(255, 255, 255, 0.2) 46%, transparent 70%);
        transform: translateX(-130%);
        animation: sheenSweep 11s cubic-bezier(0.16, 1, 0.3, 1) infinite;
      }

      .hero-image-drift {
        transform-origin: center center;
        animation: heroImageDrift 18s ease-in-out infinite;
      }

      .hero-grid {
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 74px 74px;
        mask-image: radial-gradient(circle at center, black 10%, transparent 72%);
        opacity: 0.3;
        animation: gridDrift 26s linear infinite;
      }

      .media-shell {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      .media-shell img {
        opacity: 0;
        transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .media-shell.is-loaded img {
        opacity: 1;
      }

      .media-skeleton,
      .embed-skeleton {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background:
          linear-gradient(180deg, rgba(255, 251, 247, 0.72), rgba(231, 219, 207, 0.92)),
          linear-gradient(90deg, rgba(182, 106, 89, 0.08), rgba(217, 189, 147, 0.14));
      }

      .media-skeleton::after,
      .embed-skeleton::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, transparent 18%, rgba(255, 255, 255, 0.55) 45%, transparent 72%);
        transform: translateX(-130%);
        animation: skeletonSweep 1.6s ease-in-out infinite;
      }

      .media-shell.is-loaded .media-skeleton,
      .embed-shell.is-loaded .embed-skeleton {
        opacity: 0;
        transition: opacity 0.35s ease;
        pointer-events: none;
      }

      .embed-shell {
        position: relative;
        overflow: hidden;
      }

      .embed-shell iframe {
        position: relative;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .embed-shell.is-loaded iframe {
        opacity: 1;
      }

      .shine-border {
        position: relative;
        overflow: hidden;
      }

      .shine-border::after {
        content: '';
        position: absolute;
        inset: -20%;
        background: linear-gradient(110deg, transparent 44%, rgba(255,255,255,0.16) 50%, transparent 56%);
        transform: translateX(-120%);
        animation: shimmerPass 9s ease-in-out infinite;
        pointer-events: none;
      }

      .btn-shimmer {
        position: relative;
        overflow: hidden;
      }

      .btn-shimmer::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          110deg,
          transparent 36%,
          rgba(255, 255, 255, 0.32) 50%,
          transparent 64%
        );
        transform: translateX(-100%);
      }

      .btn-shimmer:hover::after {
        transform: translateX(100%);
        transition: transform 0.7s ease;
      }

      .text-gradient {
        background: linear-gradient(135deg, #f3d08c 0%, #f47a5f 34%, #c15f64 64%, #8b3b61 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .chromatic-frame {
        position: relative;
        isolation: isolate;
      }

      .chromatic-frame::after {
        content: '';
        position: absolute;
        inset: -1px;
        z-index: -1;
        border-radius: inherit;
        background: linear-gradient(135deg, rgba(241, 154, 163, 0.46), rgba(243, 208, 140, 0.5), rgba(147, 182, 154, 0.34), rgba(193, 95, 100, 0.44));
        opacity: 0.42;
        filter: blur(14px);
        transition: opacity 0.45s ease, filter 0.45s ease;
      }

      .motion-ribbon-field {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .motion-ribbon-field span {
        position: absolute;
        left: -12%;
        width: 124%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(243, 208, 140, 0.72), rgba(241, 154, 163, 0.54), rgba(147, 182, 154, 0.46), transparent);
        opacity: 0.46;
        transform-origin: center;
        animation: ribbonTravel 15s cubic-bezier(0.45, 0, 0.2, 1) infinite;
      }

      .motion-ribbon-field span:nth-child(1) {
        top: 24%;
        --ribbon-rotate: -8deg;
        transform: rotate(-8deg);
      }

      .motion-ribbon-field span:nth-child(2) {
        top: 52%;
        --ribbon-rotate: 5deg;
        animation-delay: -5s;
        animation-duration: 18s;
        transform: rotate(5deg);
      }

      .motion-ribbon-field span:nth-child(3) {
        top: 72%;
        --ribbon-rotate: -3deg;
        animation-delay: -9s;
        animation-duration: 21s;
        transform: rotate(-3deg);
      }

      .kinetic-lines {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
      }

      .kinetic-lines::before,
      .kinetic-lines::after {
        content: '';
        position: absolute;
        inset: auto -20% 22% -20%;
        height: 12rem;
        border-radius: 999px;
        background:
          repeating-linear-gradient(
            90deg,
            rgba(193, 95, 100, 0.14) 0 1px,
            transparent 1px 34px
          ),
          linear-gradient(90deg, transparent, rgba(243, 208, 140, 0.2), transparent);
        transform: rotate(-4deg);
        animation: kineticSlide 22s linear infinite;
      }

      .kinetic-lines::after {
        inset: 12% -20% auto -20%;
        transform: rotate(6deg);
        animation-direction: reverse;
        opacity: 0.56;
      }

      .color-sweep {
        position: relative;
        overflow: hidden;
      }

      .color-sweep::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(110deg, transparent 18%, rgba(241, 154, 163, 0.12) 34%, rgba(243, 208, 140, 0.18) 48%, rgba(147, 182, 154, 0.1) 62%, transparent 78%);
        transform: translateX(-120%);
        animation: colorSweep 12s cubic-bezier(0.16, 1, 0.3, 1) infinite;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.65s;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
      }

      ::view-transition-old(root) {
        animation-name: page-out;
      }

      ::view-transition-new(root) {
        animation-name: page-in;
      }

      @keyframes pageEnter {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes page-in {
        from {
          opacity: 0;
          transform: translateY(26px) scale(0.985);
          filter: blur(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
        }
      }

      @keyframes page-out {
        from {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
        }
        to {
          opacity: 0;
          transform: translateY(-18px) scale(1.01);
          filter: blur(8px);
        }
      }

      @keyframes auraFloat {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(0, -18px, 0) scale(1.05); }
      }

      @keyframes pulseGlow {
        0%, 100% { opacity: 0.42; }
        50% { opacity: 0.68; }
      }

      @keyframes backgroundDrift {
        0%, 100% {
          background-position: 12% 10%, 82% 14%, 22% 68%, 72% 78%, 0% 0%;
        }
        50% {
          background-position: 16% 12%, 78% 18%, 26% 64%, 68% 74%, 0% 0%;
        }
      }

      @keyframes gridDrift {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(12px, -8px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(28px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes scrollLine {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(200%); }
      }

      @keyframes floatSlow {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-24px) rotate(4deg); }
      }

      @keyframes floatMedium {
        0%, 100% { transform: translateY(0px); }
        33% { transform: translateY(-14px); }
        66% { transform: translateY(7px); }
      }

      @keyframes parallaxSoft {
        0%, 100% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(0, -10px, 0); }
      }

      @keyframes shimmerPass {
        0%, 70%, 100% { transform: translateX(-120%); opacity: 0; }
        12%, 24% { transform: translateX(120%); opacity: 1; }
      }

      @keyframes haloRotate {
        from { transform: rotate(0deg) scale(1); }
        50% { transform: rotate(180deg) scale(1.08); }
        to { transform: rotate(360deg) scale(1); }
      }

      @keyframes orbDance {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        25% { transform: translate3d(8px, -18px, 0) scale(1.06); }
        50% { transform: translate3d(-12px, 10px, 0) scale(0.96); }
        75% { transform: translate3d(14px, 18px, 0) scale(1.08); }
      }

      @keyframes sheenSweep {
        0%, 58%, 100% { transform: translateX(-130%); opacity: 0; }
        10%, 24% { transform: translateX(120%); opacity: 1; }
      }

      @keyframes heroImageDrift {
        0%, 100% { transform: scale(1.04) translate3d(0, 0, 0); }
        50% { transform: scale(1.09) translate3d(0, -10px, 0); }
      }

      @keyframes skeletonSweep {
        0% { transform: translateX(-130%); }
        100% { transform: translateX(130%); }
      }

      @keyframes ribbonTravel {
        0%, 100% {
          opacity: 0.2;
          transform: translate3d(-8%, 0, 0) rotate(var(--ribbon-rotate, -6deg)) scaleX(0.78);
        }
        38% {
          opacity: 0.72;
          transform: translate3d(8%, -8px, 0) rotate(var(--ribbon-rotate, -6deg)) scaleX(1);
        }
        64% {
          opacity: 0.42;
          transform: translate3d(14%, 5px, 0) rotate(var(--ribbon-rotate, -6deg)) scaleX(0.9);
        }
      }

      @keyframes kineticSlide {
        from { background-position: 0 0, 0 0; }
        to { background-position: 340px 0, 0 0; }
      }

      @keyframes colorSweep {
        0%, 58%, 100% { transform: translateX(-120%); opacity: 0; }
        12%, 28% { transform: translateX(120%); opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      @media (max-width: 767px) {
        body,
        body::before,
        body::after,
        #main-content::before,
        #main-content::after,
        .hero-grid,
        .motion-ribbon-field span,
        .kinetic-lines::before,
        .kinetic-lines::after,
        .color-sweep::before,
        .glass-sheen::after,
        .shine-border::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }

        body::before,
        body::after,
        #main-content::after,
        .kinetic-lines {
          display: none;
        }
      }
    </style>
  </head>

  <body class="bg-background font-sans text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Vai al contenuto principale
    </a>

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <script>
      (function () {
        let revealObserver: IntersectionObserver | null = null;
        let cinemaObserver: IntersectionObserver | null = null;

        function initReveal() {
          var els = document.querySelectorAll('[data-reveal]');
          if (!els.length) return;
          if (revealObserver) revealObserver.disconnect();
          els.forEach(function (el) {
            el.classList.remove('is-visible');
          });
          revealObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  revealObserver?.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.07, rootMargin: '0px 0px -40px 0px' }
          );
          els.forEach(function (el) { revealObserver?.observe(el); });
        }

        function initSectionCinema() {
          var els = document.querySelectorAll('[data-section-cinema]');
          if (!els.length) return;
          if (cinemaObserver) cinemaObserver.disconnect();
          els.forEach(function (el) {
            el.classList.remove('is-visible');
          });
          cinemaObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  cinemaObserver?.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.16, rootMargin: '0px 0px -10% 0px' }
          );
          els.forEach(function (el) { cinemaObserver?.observe(el); });
        }

        function initMotionSystems() {
          initReveal();
          initSectionCinema();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMotionSystems);
        } else {
          initMotionSystems();
        }

        document.addEventListener('astro:page-load', initMotionSystems);
      })();
    </script>
  </body>
</html>
