# Telegram bot runtime
TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_bot_token
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_IDS=123456789,987654321

# Local storage path for booking requests
BOT_STORAGE_PATH=./bot/data/bookings.json
BOOKING_TIMEZONE=Europe/Chisinau
BOT_BOOKING_DURATION_MINUTES=120
BOT_WORKING_HOURS_START=9
BOT_WORKING_HOURS_END=19
BOT_SLOT_INTERVAL_MINUTES=30
BOT_BOOKING_DAYS_AHEAD=14

# Google Calendar integration
GOOGLE_CALENDAR_ID=your-calendar-id-or-email@example.com
GOOGLE_SERVICE_ACCOUNT_JSON=
BOT_WEBHOOK_SECRET=
