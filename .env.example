# Environment Variables

# Site Configuration
PUBLIC_SITE_URL=http://localhost:4321

# TinaCMS Configuration
# Для локальной разработки эти переменные опциональны
# TINA_CLIENT_ID=your-github-client-id
# TINA_TOKEN=your-github-token
# Если не хотите проверку удаленной GraphQL схемы (локальная работа без push):
# TINA_LOCAL_ONLY=true

# Для использования на локальной машине без GitHub (разработка):
# Просто оставьте эти строки закомментированными и используйте локальный режим

# Instagram Graph API (страница /social)
# Долгосрочный токен доступа (срок: 60 дней, обновляется автоматически при каждом запросе).
# Как получить:
#   1. Создайте Facebook App → developers.facebook.com
#   2. Добавьте продукт "Instagram"
#   3. Подключите Instagram Business/Creator аккаунт
#   4. Получите long-lived access token через Graph API Explorer
#      GET https://graph.instagram.com/me?fields=id,username&access_token=TOKEN
# INSTAGRAM_ACCESS_TOKEN=your-instagram-graph-token

