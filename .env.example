# Site / Astro
PUBLIC_CAL_BOOKING_URL=https://cal.com/your-team-or-username/booking
PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot_username

# Booking webhook -> Telegram admin notifications
TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_bot_token
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# Telegram bot booking calendar
GOOGLE_CALENDAR_ID=your-calendar-id-or-email@example.com
GOOGLE_SERVICE_ACCOUNT_JSON=

# Contact form -> Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_CONTACT_INQUIRIES_TABLE=contact_inquiries

# TinaCMS local mode
PUBLIC_TINA_CLIENT_ID=replace_with_tina_client_id
TINA_CLIENT_ID=replace_with_tina_client_id
TINA_PUBLIC_CLIENT_ID=replace_with_tina_public_client_id
TINA_TOKEN=replace_with_tina_token
TINA_LOCAL_ONLY=true
